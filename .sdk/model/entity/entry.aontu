# Entity: entry

main: kit: entity: entry: {

  alias: field: {}

  fields: [
    {
      name: "meaning"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "origin"
      req: false
      type: "`$STRING`"
    }
    {
      name: "phonetic"
      req: false
      type: "`$STRING`"
    }
    {
