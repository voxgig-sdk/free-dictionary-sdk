          parts: [
            "entries"
            "{language}"
            "{word}"
          ]
          select: {
            exist: [
              "language"
              "word"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

